# ==========================================================================
# This project talks to TWO separate databases. Keep them straight:
#
#   1. CHAT PERSISTENCE  - PostgreSQL on the app server. Ours. Stores only
#      LangGraph's checkpoint_* tables (conversation history). Created
#      automatically on first startup - no manual schema setup needed.
#
#   2. STORE BUSINESS DATA - the backend team's SQL Server. NOT ours.
#      Products, orders, carts, reviews. Read-only as far as this app is
#      concerned. Never point this app's writes at it.
# ==========================================================================

# --- 1. Chat persistence (same-server PostgreSQL) ------------------------
# Leave URL empty for local PostgreSQL; a nonempty URL overrides the parts.
# Optional remote PostgreSQL URL:
#   CHECKPOINT_DB_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
CHECKPOINT_DB_URL=

# Local development uses localhost. AWS Docker uses chatbot-postgres via
# compose.persistence.yml, with CHECKPOINT_DB_SSLMODE=disable on its private network.
CHECKPOINT_DB_HOST=localhost
CHECKPOINT_DB_PORT=5432
CHECKPOINT_DB_NAME=ecommerce_rag
CHECKPOINT_DB_USER=postgres
CHECKPOINT_DB_PASSWORD=

# TLS. Left unset, any non-local host defaults to `require`, which is what
# Neon needs; localhost defaults to `prefer`. Only set this to override.
# CHECKPOINT_DB_SSLMODE=require

# --- 2. Store business data (backend team's SQL Server) -------------------
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# Connections are pooled - see db.py.
# MSSQL_POOL_SIZE=5
# MSSQL_PING_AFTER_IDLE_S=60

# --- Model providers ------------------------------------------------------
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# --- Tracing (optional) ---------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
